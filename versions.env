# What every released artifact is a function of, alongside the zkVM's own
# <zkvm>/versions.env, so a bump is a visible commit.
#
# NIMBUS_REF   commit of nimbus-eth1 the guest is built from
# XPACK_GCC    riscv-none-elf-gcc release the guest is tested with

NIMBUS_REPO=https://github.com/status-im/nimbus-eth1
NIMBUS_REF=3a36e9ae6c9d75df152cdafd40b1a901cea6418c

XPACK_GCC_VERSION=15.2.0-1
